{
    "manifestVersion": 1,
    "id": "test/vitest",
    "name": "Vitest",
    "version": "1.0.0",
    "description": "Vitest with a coverage gate and a health-check test wired to the chosen HTTP framework.",
    "category": "test",
    "tags": ["vitest", "test", "coverage"],
    "provides": ["test", "test:vitest"],
    "conflicts": ["test"],
    "requires": ["runtime:node"],
    "after": ["http/express", "http/fastify", "http/hono"],
    "priority": 92,
    "engines": {
        "atarashi": ">=1.0.0-0 <2.0.0",
        "node": ">=20.11"
    },
    "files": [
        {
            "from": "files/vitest.config.ts.hbs",
            "to": "vitest.config.{{#when \"provides('language:typescript')\"}}ts{{else}}js{{/when}}"
        },
        {
            "from": "files/tests/health.test.ts.hbs",
            "to": "tests/health.{{#when \"provides('language:typescript')\"}}test.ts{{else}}test.js{{/when}}"
        }
    ],
    "devDependencies": {
        "vitest": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "supertest": {
            "version": "^7.1.4",
            "when": "has('http/express')"
        },
        "@types/supertest": {
            "version": "^6.0.3",
            "when": "provides('language:typescript') && has('http/express')"
        }
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "gitignore": ["coverage/"],
    "nextSteps": [
        "Run the tests:  {{ pm.run }} test",
        "Tests read the same environment as the app, so export your .env before running them"
    ],
    "contributions": [
        {
            "target": "pnpm-workspace.yaml",
            "merge": "yaml-deep",
            "value": {
                "allowBuilds": {
                    "esbuild": true
                },
                "onlyBuiltDependencies": ["esbuild"]
            },
            "when": "pm.name === 'pnpm'"
        }
    ]
}
