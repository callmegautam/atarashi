# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json {{ pm.lockfile }}* ./
RUN {{ pm.install }}
COPY . .
{{#when "provides('language:typescript')"}}
RUN {{ pm.run }} build
{{/when}}

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json {{ pm.lockfile }}* ./
RUN {{ pm.install }}
{{#when "provides('language:typescript')"}}
COPY --from=build /app/dist ./dist
{{/when}}
{{#when "provides('language:javascript')"}}
COPY --from=build /app/src ./src
{{/when}}

EXPOSE 3000
USER node
CMD ["node", "{{#when "provides('language:typescript')"}}dist/index.js{{else}}src/index.js{{/when}}"]
