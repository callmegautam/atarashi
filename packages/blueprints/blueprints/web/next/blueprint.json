{
    "manifestVersion": 1,
    "id": "web/next",
    "name": "Next.js + Tailwind",
    "version": "1.0.0",
    "description": "Next.js App Router with Tailwind v4, TypeScript and the default React Server Component setup.",
    "category": "frontend",
    "tags": ["next", "react", "tailwind", "frontend", "ssr"],
    "provides": ["ui", "ui:next"],
    "conflicts": ["ui"],
    "requires": ["language:typescript"],
    "after": ["core/node-ts"],
    "priority": 55,
    "engines": {
        "atarashi": ">=1.0.0-0 <2.0.0",
        "node": ">=20.19"
    },
    "files": [
        {
            "from": "files/package.json.hbs",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}package.json",
            "merge": "json-deep"
        },
        {
            "from": "files/next.config.mjs",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}next.config.mjs"
        },
        {
            "from": "files/postcss.config.mjs",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}postcss.config.mjs"
        },
        {
            "from": "files/tsconfig.json",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}tsconfig.json"
        },
        {
            "from": "files/app/layout.tsx.hbs",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}app/layout.tsx"
        },
        {
            "from": "files/app/page.tsx.hbs",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}app/page.tsx"
        },
        {
            "from": "files/app/globals.css",
            "to": "{{#when \"provides('http')\"}}web/{{/when}}app/globals.css"
        }
    ],
    "scripts": {
        "dev:web": {
            "value": "cd web && {{ pm.run }} dev",
            "when": "provides('http')"
        },
        "build:web": {
            "value": "cd web && {{ pm.run }} build",
            "when": "provides('http')"
        }
    },
    "gitignore": [".next/", "next-env.d.ts", ".vercel"],
    "nextSteps": [
        "Start the Next dev server:  {{#when \"provides('http')\"}}{{ pm.run }} dev:web{{else}}{{ pm.run }} dev{{/when}}"
    ],
    "contributions": [
        {
            "target": "pnpm-workspace.yaml",
            "merge": "yaml-deep",
            "value": {
                "allowBuilds": {
                    "esbuild": true
                },
                "onlyBuiltDependencies": ["esbuild"]
            },
            "when": "pm.name === 'pnpm'"
        }
    ]
}
